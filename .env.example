# Copy to .env for local development. Never commit real values.
MINTLESS_DATA_DIR=./data
MINTLESS_HOST=127.0.0.1
MINTLESS_PORT=3000
# Base64 of 32 random bytes. Keep the key outside the data directory and its backups.
MINTLESS_MASTER_KEY_FILE=./.local/master.key
# 1 serves the Vue app through Vite with hot reload from the same process and port.
MINTLESS_DEV=1
# Comma-separated host names allowed to reach the dev server through a proxy.
MINTLESS_DEV_ALLOWED_HOSTS=
SYNC_INTERVAL_HOURS=12
MINTLESS_SESSION_TTL_HOURS=720
