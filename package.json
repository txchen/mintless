{
  "name": "mintless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MINTLESS_DEV=1 vpx src/server/main.ts",
    "build": "vp build --configLoader runner",
    "start": "node src/server/main.ts",
    "cli": "node src/server/cli.ts",
    "check": "vp check && vue-tsc --noEmit -p tsconfig.json",
    "test": "vp test --configLoader runner",
    "test:browser": "node scripts/browser-check.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "better-sqlite3": "13.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "plaid": "51.0.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@lucide/vue": "1.72.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.11",
    "playwright": "1.65.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite-plus": "1.6.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1",
    "vue-sonner": "2.0.9",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.12"
  }
}
